#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_TIMER ICON "@CMAKE_CURRENT_SOURCE_DIR@/../time.ico"
1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/sleeptimer.xml"

IDD_TIMER DIALOGEX 0, 0, 284, 166
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Sleep Timer"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Hours", -1, 14, 12, 70, 12
    EDITTEXT IDC_HOURS, 14, 26, 70, 24, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_HOURS_SPIN, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_ARROWKEYS, 74, 26, 10, 24
    LTEXT "&Minutes", -1, 106, 12, 70, 12
    EDITTEXT IDC_MINUTES, 106, 26, 70, 24, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_MINUTES_SPIN, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_ARROWKEYS, 166, 26, 10, 24
    LTEXT "&Seconds", -1, 198, 12, 70, 12
    EDITTEXT IDC_SECONDS, 198, 26, 70, 24, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_SECONDS_SPIN, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_ARROWKEYS, 258, 26, 10, 24
    CONTROL "St&andby", IDC_STANDBY, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 14, 62, 78, 12
    CONTROL "&Hibernate", IDC_HIBERNATE, "Button", BS_AUTORADIOBUTTON, 106, 62, 78, 12
    CONTROL "Shut &down", IDC_SHUTDOWN, "Button", BS_AUTORADIOBUTTON, 198, 62, 70, 12
    CONTROL "&Pause media", IDC_PAUSE_MEDIA, "Button", BS_AUTORADIOBUTTON, 14, 82, 254, 12
    CONTROL "&Mute sound", IDC_MUTE, "Button", BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 14, 102, 254, 12
    CONTROL "", IDC_PROGRESS, PROGRESS_CLASS, WS_BORDER, 14, 124, 254, 6
    LTEXT "Ready", IDC_STATUS, 14, 142, 176, 12
    DEFPUSHBUTTON "&Start", IDOK, 198, 138, 70, 20
END
